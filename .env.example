# Copy this file to .env.local and fill in the real values.
# You will find these in your Supabase project settings → API.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# WhatsApp number to receive orders (international format, no + or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER=972586666623

# Server-only (NEVER commit or share). Used by scripts and admin API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
